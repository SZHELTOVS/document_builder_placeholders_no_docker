# Создайте .gitignore в корне
@"
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Virtual Environment
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Django
*.sqlite3
db.sqlite3

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build
dist/
build/
"@ | Out-File -FilePath .gitignore -Encoding UTF8